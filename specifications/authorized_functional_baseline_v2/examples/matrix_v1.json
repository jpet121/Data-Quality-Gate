{
  "version": "demo-v1",
  "limits": {
    "max_event_bytes": 4096,
    "max_tokens": 32,
    "max_batch": 10000
  },
  "aliases": {
    "event": "event_type",
    "tenant": "tenant_id",
    "order": "order_id"
  },
  "events": [
    {
      "event_type": "ORDER_CREATED",
      "schema_id": "ORDER_CREATED",
      "schema_version": "1",
      "registry_key": "order_created.v1",
      "matcher": {
        "field": "event",
        "equals": "ORDER_CREATED",
        "priority": 10
      },
      "required": [
        "event_type",
        "event_id",
        "tenant_id",
        "order_id",
        "occurred_at",
        "source",
        "customer_ref",
        "gross_amount",
        "currency"
      ],
      "optional": [
        "lines_json"
      ],
      "field_types": {
        "event_type": "str",
        "event_id": "str",
        "tenant_id": "str",
        "order_id": "str",
        "occurred_at": "timestamp",
        "source": "str",
        "customer_ref": "str",
        "gross_amount": "money",
        "currency": "str",
        "lines_json": "lines_json"
      }
    },
    {
      "event_type": "PAYMENT_AUTHORIZED",
