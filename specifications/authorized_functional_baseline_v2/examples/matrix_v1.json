      "event_type": "SHIPMENT_DISPATCHED",
      "schema_id": "SHIPMENT_DISPATCHED",
      "schema_version": "1",
      "registry_key": "shipment_dispatched.v1",
      "matcher": {
        "field": "event",
        "equals": "SHIPMENT_DISPATCHED",
        "priority": 10
